---
layout: false
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Noah Rubin Technologies, LLC</title>
    <meta name="description"
        content="Noah Rubin Technologies, LLC is an independent, one-man app development studio building focused, high-quality, and delightful mobile and web experiences.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://nrubintech.com">
    <meta property="og:title" content="Noah Rubin Technologies, LLC">
    <meta property="og:description"
        content="Independent app development studio building clean, focused, and delightful experiences.">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="Noah Rubin Technologies, LLC">
    <meta property="twitter:description"
        content="Independent app development studio building clean, focused, and delightful experiences.">

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="assets/css/style.css">
</head>

<body>
    {% macro appCard(name, description, icon, url, id, isExternal=false) %}
    <a href="{{ url }}" class="app-card" id="{{ id }}"
        {% if isExternal %}target="_blank" rel="noopener noreferrer"{% endif %}>
        <div class="app-info">
            <div class="app-icon-wrapper has-image">
                <img src="{{ icon | url }}" alt="{{ name }} Logo" class="app-icon-img" width="48"
                    height="48">
            </div>
            <h3 class="app-title">{{ name }}</h3>
            <p class="app-description">
                {{ description | safe }}
            </p>
        </div>
    </a>
    {% endmacro %}

    <div class="container">
        <!-- Header Section -->
        <header class="site-header">
            <div class="logo-area">
                <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true">
                    <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="4" />
                    <path d="M35 70V30L55 52.5L55 30H65V70L45 47.5L45 70H35Z" fill="currentColor" />
                </svg>
            </div>
            <h1 class="company-name">Noah Rubin Technologies</h1>
            <p class="subtitle">Apps and experiments by <a href="https://noahzrubin.com" class="text-link" target="_blank" rel="noopener noreferrer">Noah Rubin</a>.</p>
        </header>

        <!-- Main Content -->
        <main class="site-main">

            <!-- Apps Grid Section -->
            <section class="apps-section" aria-labelledby="apps-heading">
                <h2 id="apps-heading" class="section-title">Apps</h2>
                <div class="apps-grid">
                    <!-- App 1: Finale (Hardcoded) -->
                    {{ appCard(
                        name="Finale",
                        description="A feature-rich Last.fm client.",
                        icon="assets/icons/finale.png",
                        url="https://finale.app",
                        id="link-app-finale",
                        isExternal=true
                    ) }}

                    <!-- Dynamic Apps from collection -->
                    {% for app in collections.app %}
                        {{ appCard(
                            name=app.data.name,
                            description=app.data.summary or app.data.tagline,
                            icon=app.data.icon,
                            url=('/' ~ app.fileSlug ~ '/') | url,
                            id="link-app-" ~ app.fileSlug,
                            isExternal=false
                        ) }}
                    {% endfor %}

                    <!-- App 3: More to come (Placeholder) -->
                    <article class="app-card placeholder">
                        <div class="app-info">
                            <div class="app-icon-wrapper">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                    xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"
                                        stroke-dasharray="4 4" />
                                    <path d="M12 8V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                    <path d="M8 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                </svg>
                            </div>
                            <h3 class="app-title">More to come</h3>
                            <p class="app-description">
                                Currently designing and developing new mobile and web experiences. Stay tuned.
                            </p>
                        </div>
                    </article>
                </div>
            </section>
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <p>&copy; <span id="current-year">2026</span> Noah Rubin Technologies, LLC. All rights reserved.</p>
        </footer>
    </div>

    <!-- Small script to ensure copyright year is always up to date -->
    <script>
        document.getElementById('current-year').textContent = new Date().getFullYear();
    </script>
</body>

</html>
