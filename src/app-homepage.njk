---
pagination:
  data: collections.app
  size: 1
  alias: app
permalink: "{{ app.fileSlug }}/index.html"
layout: layouts/base-app.njk
---

  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <h1>{{ app.data.tagline }}</h1>
      <p class="hero-sub">{{ app.data.hero.sub }}</p>
      <a href="{{ app.data.appStoreUrl }}" class="app-store-btn" id="hero-cta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
        </svg>
        Download on the App Store
      </a>
    </div>
    {% if app.data.hero.foldable %}
    <div class="duo-showcase">
      <div class="duo-stage">
        <div class="duo-device-frame" id="duo-device-frame" title="Click to fold or unfold">
          <img
            src="{{ app.data.hero.foldable.open.src | url }}"
            alt="{{ app.data.hero.foldable.open.alt }}"
            class="duo-img duo-img-open"
          />
          <img
            src="{{ app.data.hero.foldable.closed.src | url }}"
            alt="{{ app.data.hero.foldable.closed.alt }}"
            class="duo-img duo-img-closed"
          />
        </div>
      </div>

      <fieldset class="duo-toggle">
        <legend class="sr-only">iPhone Duo display state</legend>
        <label class="duo-toggle-option">
          <input type="radio" name="duo-state" value="open" class="duo-input duo-input-open" checked />
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2.5" />
            <line x1="12" y1="4" x2="12" y2="20" stroke-dasharray="2 2" />
          </svg>
          <span>{{ app.data.hero.foldable.open.label }}</span>
        </label>
        <label class="duo-toggle-option">
          <input type="radio" name="duo-state" value="closed" class="duo-input duo-input-closed" />
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="3" width="12" height="18" rx="2.5" />
            <circle cx="12" cy="12" r="2.5" />
          </svg>
          <span>{{ app.data.hero.foldable.closed.label }}</span>
        </label>
      </fieldset>

      <p class="duo-caption" aria-live="polite">
        <span class="duo-caption-open">{{ app.data.hero.foldable.open.caption }}</span>
        <span class="duo-caption-closed">{{ app.data.hero.foldable.closed.caption }}</span>
      </p>
    </div>
    <script>
      (function () {
        const showcase = document.querySelector('.duo-showcase');
        const frame = document.getElementById('duo-device-frame');
        const openInput = showcase?.querySelector('.duo-input-open');
        const closedInput = showcase?.querySelector('.duo-input-closed');

        if (frame && openInput && closedInput) {
          frame.addEventListener('click', () => {
            const nextInput = openInput.checked ? closedInput : openInput;
            nextInput.checked = true;
            nextInput.dispatchEvent(new Event('change', { bubbles: true }));
          });
        }

        if (!window.CSS || !CSS.supports('selector(:has(*))')) {
          showcase?.addEventListener('change', () => {
            showcase.classList.toggle('is-closed', Boolean(closedInput?.checked));
          });
        }
      })();
    </script>
    {% else %}
    <div class="hero-screenshots">
      {% for screenshot in app.data.hero.screenshots %}
      <div class="phone-frame">
        <img src="{{ screenshot.src | url }}" alt="{{ screenshot.alt }}" />
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <!-- FEATURES -->
  <section class="features" id="features">
    <div class="section-inner">
      <h2>{{ app.data.featuresTitle }}</h2>
      <div class="feature-grid">
        {% for feature in app.data.features %}
        <div class="feature-card">
          <div class="feature-icon">{{ feature.icon }}</div>
          <h3>{{ feature.title }}</h3>
          <p>{{ feature.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- CALLOUT -->
  <section class="privacy-callout">
    <div class="section-inner privacy-callout-inner">
      <div class="privacy-text">
        <h2>{{ app.data.callout.title }}</h2>
        <p>{{ app.data.callout.desc }}</p>
        <a href="{{ '/' | url }}{{ app.fileSlug }}/privacy/" class="link-arrow">Read our Privacy Policy →</a>
      </div>
      <div class="privacy-icon-wrap">
        <div class="privacy-icon">{{ app.data.callout.icon }}</div>
      </div>
    </div>
  </section>
