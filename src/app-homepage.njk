---
pagination:
  data: collections.app
  size: 1
  alias: app
permalink: "{{ app.fileSlug }}/index.html"
layout: layouts/base-app.njk
---

  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <h1>{{ app.data.tagline }}</h1>
      <p class="hero-sub">{{ app.data.hero.sub }}</p>
      <a href="{{ app.data.appStoreUrl }}" class="app-store-btn" id="hero-cta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
        </svg>
        Download on the App Store
      </a>
    </div>
    <div class="hero-screenshots">
      {% for screenshot in app.data.hero.screenshots %}
      <div class="phone-frame">
        <img src="{{ screenshot.src | url }}" alt="{{ screenshot.alt }}" />
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features" id="features">
    <div class="section-inner">
      <h2>{{ app.data.featuresTitle }}</h2>
      <div class="feature-grid">
        {% for feature in app.data.features %}
        <div class="feature-card">
          <div class="feature-icon">{{ feature.icon }}</div>
          <h3>{{ feature.title }}</h3>
          <p>{{ feature.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- CALLOUT -->
  <section class="privacy-callout">
    <div class="section-inner privacy-callout-inner">
      <div class="privacy-text">
        <h2>{{ app.data.callout.title }}</h2>
        <p>{{ app.data.callout.desc }}</p>
        <a href="{{ '/' | url }}{{ app.fileSlug }}/privacy/" class="link-arrow">Read our Privacy Policy →</a>
      </div>
      <div class="privacy-icon-wrap">
        <div class="privacy-icon">{{ app.data.callout.icon }}</div>
      </div>
    </div>
  </section>
